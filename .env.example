# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense
# ZidroTool shows real ads through AdSense only. Leave these empty to run the
# site with zero ad slots (nothing renders, no placeholders). Fill in the
# client id + the slot ids you actually created in AdSense to turn a
# placement on; a placement with no slot id stays off even if the client id
# is set.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_HEADER=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_FOOTER=
