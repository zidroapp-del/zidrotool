# Supabase project settings (required only if you want account sign-in, signup, and sync features)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# YouTube Data API v3 (strongly recommended for reliable video/channel statistics)
# Create a Google Cloud API key and enable YouTube Data API v3 for the project.
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_KEY

# Video downloader providers
# Recommended: deploy services/yt-dlp-api and put its public URL here.
YTDLP_API_URL=https://YOUR-YTDLP-SERVICE.example.com
APIFY_TOKEN=YOUR_APIFY_TOKEN
APIFY_VIDEO_ACTOR=miccho27~social-video-downloader

# Optional: your own/authorized Cobalt API instance.
# Do not rely on the old public endpoint for production; hosted Cobalt instances may require auth or block third-party projects.
COBALT_API_URL=https://YOUR-COBALT-INSTANCE.example.com
COBALT_API_KEY=YOUR_COBALT_API_KEY

# Temporary email provider
TEMPMAIL_API_URL=https://api.mail.tm
# Optional independent fallback provider using the same Mail.tm-compatible API shape.
TEMPMAIL_FALLBACK_API_URL=
